{# Icon link #}
{% macro footer_icon_link(href, icon, label) -%}
    <a href="{{ href }}"
       target="_blank"
       rel="noopener noreferrer"
       class="hover:underline flex items-center">
        <img src="/static/{{ icon }}"
             alt="{{ label }} logo"
             class="w-4 h-4 mr-1 dark:invert dark:opacity-80">
        {{ label }}
    </a>
{%- endmacro %}
